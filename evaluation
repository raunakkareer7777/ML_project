import numpy as np
import pandas as pd
import streamlit as st
import plotly.graph_objects as go
from scipy.optimize import linear_sum_assignment
from sklearn.cluster import KMeans, DBSCAN
from sklearn.datasets import make_blobs, make_moons, make_circles
from sklearn.model_selection import train_test_split
from sklearn.preprocessing import StandardScaler
from sklearn.metrics import (
    accuracy_score, precision_recall_fscore_support, confusion_matrix,
    adjusted_rand_score, normalized_mutual_info_score,
    silhouette_score, davies_bouldin_score,
)

PALETTE = ["#E24B4A", "#185FA5", "#1D9E75", "#EF9F27", "#9B59B6", "#E67E22"]
NOISE_COLOR = "#888888"


# ── Data with ground truth (true noise points are labelled -1) ────────────────
def make_data(name, n=400, noise_frac=0.05, seed=42):
    if name == "Blobs":
        X, y = make_blobs(n_samples=n, centers=3, cluster_std=0.8, random_state=seed)
    elif name == "Two Moons":
        X, y = make_moons(n_samples=n, noise=0.07, random_state=seed)
    else:
        X, y = make_circles(n_samples=n, noise=0.05, factor=0.45, random_state=seed)
    rng = np.random.RandomState(seed)
    n_noise = int(n * noise_frac)
    lo, hi = X.min(0) - 0.5, X.max(0) + 0.5
    X = np.vstack([X, rng.uniform(lo, hi, (n_noise, 2))])
    y = np.concatenate([y, np.full(n_noise, -1)])
    return StandardScaler().fit_transform(X), y


# ── Match arbitrary cluster IDs to true classes (Hungarian algorithm) ─────────
def align_labels(y_true, y_pred):
    t_cls = [c for c in np.unique(y_true) if c != -1]
    p_cls = [c for c in np.unique(y_pred) if c != -1]
    mapping = {}
    if t_cls and p_cls:
        cont = np.array([[np.sum((y_true == t) & (y_pred == p)) for p in p_cls]
                         for t in t_cls])
        rows, cols = linear_sum_assignment(-cont)
        mapping = {p_cls[j]: t_cls[i] for i, j in zip(rows, cols)}
    # noise stays noise; clusters with no match become -9 ("wrong class")
    return np.array([-1 if p == -1 else mapping.get(p, -9) for p in y_pred])


def compute_metrics(X, y_true, y_pred):
    y_al = align_labels(y_true, y_pred)
    classes = np.unique(y_true)
    p, r, f, _ = precision_recall_fscore_support(
        y_true, y_al, labels=classes, average="macro", zero_division=0)
    mask = y_pred != -1
    n_cl = len(set(y_pred[mask]))
    sil = silhouette_score(X[mask], y_pred[mask]) if n_cl >= 2 and mask.sum() > n_cl else np.nan
    dbi = davies_bouldin_score(X[mask], y_pred[mask]) if n_cl >= 2 else np.nan
    return {
        "Accuracy": accuracy_score(y_true, y_al),
        "Precision (macro)": p, "Recall (macro)": r, "F1 (macro)": f,
        "Adjusted Rand Index": adjusted_rand_score(y_true, y_pred),
        "Normalized Mutual Info": normalized_mutual_info_score(y_true, y_pred),
        "Silhouette": sil, "Davies-Bouldin": dbi,
        "Clusters found": n_cl, "Noise points": int((y_pred == -1).sum()),
    }, y_al


# ── Plot helpers ──────────────────────────────────────────────────────────────
def scatter(X, labels, title):
    fig = go.Figure()
    for l in sorted(set(labels)):
        m = labels == l
        color = NOISE_COLOR if l < 0 else PALETTE[l % len(PALETTE)]
        name = "Noise" if l == -1 else f"Cluster {l}"
        fig.add_trace(go.Scatter(x=X[m, 0], y=X[m, 1], mode="markers", name=name,
                                 marker=dict(size=6, color=color,
                                             symbol="x" if l == -1 else "circle")))
    fig.update_layout(template="plotly_dark", height=340, title=title,
                      margin=dict(t=50, b=20, l=20, r=20),
                      legend=dict(orientation="h", y=-0.15))
    return fig


def conf_fig(y_true, y_al, title):
    labels = list(np.unique(y_true)) + ([-9] if (y_al == -9).any() else [])
    names = ["Noise" if l == -1 else ("Other" if l == -9 else f"Class {l}") for l in labels]
    cm = confusion_matrix(y_true, y_al, labels=labels)
    fig = go.Figure(go.Heatmap(z=cm, x=names, y=names, text=cm, texttemplate="%{text}",
                               colorscale="Blues", showscale=False))
    fig.update_layout(template="plotly_dark", height=320, title=title,
                      xaxis_title="Predicted", yaxis_title="True",
                      margin=dict(t=50, b=40, l=40, r=20))
    return fig


# ── Streamlit page ────────────────────────────────────────────────────────────
def run_evaluation():
    st.title("Model Evaluation — K-Means vs DBSCAN")
    st.caption("Real scikit-learn models scored against known ground-truth labels.")

    st.sidebar.header("Evaluation settings")
    ds = st.sidebar.selectbox("Dataset", ["Blobs", "Two Moons", "Concentric Circles"])
    n = st.sidebar.slider("Number of points", 200, 1000, 400, 50)
    noise_frac = st.sidebar.slider("Noise fraction", 0.0, 0.2, 0.05, 0.01)
    seed = st.sidebar.number_input("Random seed", 0, 9999, 42)
    k = st.sidebar.slider("K-Means: k", 2, 8, 3 if ds == "Blobs" else 2)
    eps = st.sidebar.slider("DBSCAN: eps", 0.05, 1.0, 0.2, 0.01)
    min_pts = st.sidebar.slider("DBSCAN: minPts", 2, 15, 5)
    test_size = st.sidebar.slider("K-Means test split", 0.1, 0.5, 0.3, 0.05)

    X, y = make_data(ds, n, noise_frac, seed)

    # K-Means: genuine train/test split (fit on train, predict on unseen test)
    Xtr, Xte, ytr, yte = train_test_split(X, y, test_size=test_size, random_state=seed)
    km = KMeans(n_clusters=k, n_init=10, random_state=seed).fit(Xtr)
    km_test_pred = km.predict(Xte)
    km_all_pred = km.predict(X)
    km_metrics, km_al = compute_metrics(Xte, yte, km_test_pred)

    # DBSCAN has no predict(), so it is fitted and evaluated on the full dataset
    db_pred = DBSCAN(eps=eps, min_samples=min_pts).fit_predict(X)
    db_metrics, db_al = compute_metrics(X, y, db_pred)

    c1, c2, c3 = st.columns(3)
    c1.plotly_chart(scatter(X, y, "Ground truth"), use_container_width=True)
    c2.plotly_chart(scatter(X, km_all_pred, f"K-Means (k={k})"), use_container_width=True)
    c3.plotly_chart(scatter(X, db_pred, f"DBSCAN (eps={eps}, minPts={min_pts})"),
                    use_container_width=True)

    st.subheader("Metrics")
    df = pd.DataFrame({
        f"K-Means (test set, n={len(Xte)})": km_metrics,
        f"DBSCAN (full data, n={len(X)})": db_metrics,
    }).round(3)
    st.dataframe(df, use_container_width=True)
    st.caption("Accuracy / precision / recall / F1 are computed after matching each "
               "cluster to its best true class (Hungarian algorithm). True noise points "
               "count as their own class, so K-Means, which cannot output noise, is penalised for them.")

    m1, m2 = st.columns(2)
    m1.plotly_chart(conf_fig(yte, km_al, "K-Means confusion matrix (test)"), use_container_width=True)
    m2.plotly_chart(conf_fig(y, db_al, "DBSCAN confusion matrix"), use_container_width=True)

    st.subheader("Hyperparameter sweeps")
    s1, s2 = st.columns(2)
    ks = list(range(2, 9))
    inertia, sil = [], []
    for kk in ks:
        m = KMeans(n_clusters=kk, n_init=10, random_state=seed).fit(Xtr)
        inertia.append(m.inertia_)
        sil.append(silhouette_score(Xtr, m.labels_))
    s1.markdown("**K-Means: elbow (inertia) and silhouette vs k**")
    s1.line_chart(pd.DataFrame({"Inertia": inertia, "Silhouette": sil}, index=ks))

    eps_grid = np.round(np.arange(0.05, 0.65, 0.05), 2)
    ari = [adjusted_rand_score(y, DBSCAN(eps=e, min_samples=min_pts).fit_predict(X))
           for e in eps_grid]
    s2.markdown("**DBSCAN: Adjusted Rand Index vs eps**")
    s2.line_chart(pd.DataFrame({"ARI": ari}, index=eps_grid))
